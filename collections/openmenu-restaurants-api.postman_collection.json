          "request": {
            "name": "List Restaurants By Location",
            "description": {
              "content": "List restaurants in a geographic area. Optionally filter by restaurant name using the `s` parameter. At least one of `postal_code` or `city` is required, along with `country`.",
              "type": "text/plain"
