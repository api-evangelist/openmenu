  "info": {
    "_postman_id": "dbdbcacc-00ab-4cfa-a1b5-01ed8a75aad7",
    "name": "OpenMenu Analytics API",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": {
      "content": "The OpenMenu REST API returns structured restaurant and menu data built on the OpenMenu Format. Standard endpoints cover search, restaurant, location, deals, and ingredients, returning menu items with prices, locations, and dietary attributes. An Enhanced enterprise tier adds DishDNA machine-learning analysis, trends, heatmaps, and gap analysis. Authentication uses an API key passed as the `key` query parameter, and a sandbox mode (`s=sample` or `id=sample`) returns fixed sample JSON without consuming credits.\n\nContact Support:\n Name: Kin Lane\n Email: kin@apievangelist.com",
      "type": "text/plain"
    }
  }
